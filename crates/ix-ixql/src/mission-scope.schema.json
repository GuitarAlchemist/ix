{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ix:mission-scope:0.1.0-draft",
  "title": "IXQL scope refinement proposal (no execution authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dsl_version",
    "engine",
    "function_version",
    "implementation_sha",
    "mission_id",
    "attempt_id",
    "revision",
    "refusal_id",
    "owner",
    "paths"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "dsl_version": {
      "const": "1"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_sha"
      ],
      "properties": {
        "version": {
          "const": "0.1.0"
        },
        "source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "function_version": {
      "const": "0.1.0"
    },
    "implementation_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "refusal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  }
}
