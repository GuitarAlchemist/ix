{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guitar-alchemist/ix-ixql/tests/qa-verdict-subset.json",
  "title": "QA Verdict (test subset)",
  "description": "A deliberately partial stand-in for the QA-verdict contract, used only to exercise ix-ixql's at-rest schema gate. The canonical schema lives in ga (docs/contracts/qa-verdict.schema.json) and is already vendored once, into Demerzel (schemas/contracts/qa-verdict.schema.json), under a no-drift policy. Copying it a third time into ix would create a copy nobody is watching. What this fixture must encode is only what the test asserts: that a conforming write passes the gate and a non-conforming one is refused before it reaches the host.",
  "type": "object",
  "required": [
    "schema_version",
    "verdict_id",
    "produced_at",
    "producer",
    "target",
    "risk_tier",
    "verdict",
    "blast_radius",
    "evidence",
    "followups",
    "reviewer_chain",
    "narrative"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "verdict_id": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "risk_tier": { "enum": ["P0", "P1", "P2", "P3"] },
    "verdict": { "enum": ["pass", "fail", "blocked", "informational"] },
    "target": {
      "type": "object",
      "required": ["kind", "repo", "ref"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "blast_radius": {
      "type": "object",
      "required": ["estimated_blast_score"],
      "properties": {
        "estimated_blast_score": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": { "type": "array" },
    "followups": { "type": "array" },
    "reviewer_chain": { "type": "array", "minItems": 1 },
    "narrative": { "type": "string", "minLength": 1 }
  }
}
