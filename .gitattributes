# Determinism fixtures for the Pareto frontier pipeline (issue #294):
# byte-identical output is the contract, so git must never rewrite their EOLs.
crates/ix-duck/tests/fixtures/pareto/*.csv -text

# Determinism fixtures for the compiled-IXQL plan pipeline (refs #281):
# the DuckDB surface must reproduce them byte for byte, so git must never
# rewrite their EOLs.
crates/ix-duck/tests/fixtures/ixql/*.csv -text
# Same contract for the H0 persistence fixtures (gap-matrix row B1b).
crates/ix-duck/tests/fixtures/persistence/*.csv -text

# ix-origami pins its FOLD fixtures by sha256, so git must never rewrite their EOLs.
crates/ix-origami/tests/fixtures/*.fold -text

# Go sources stay LF on every checkout: gofmt normalises CRLF away, so a Windows
# runner with core.autocrlf=true would list every file as unformatted (ixctl-go job).
*.go text eol=lf

# The ixctl gate and its helpers run on both CI rows; LF on every checkout keeps the Windows
# worktree free of "LF will be replaced by CRLF" noise on each diff of the gate.
go/ixctl/e2e/*.py text eol=lf
