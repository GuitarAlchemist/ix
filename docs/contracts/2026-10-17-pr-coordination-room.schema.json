{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GuitarAlchemist/ix/contracts/pr-coordination-room-v1.json",
  "title": "PR coordination room message",
  "description": "The coord block of one room comment, parsed as key/value pairs: one `key: value` per line, split at the first `: `, every value a string (no YAML typing). Contract: 2026-10-17-pr-coordination-room.contract.md (v0.1 draft, pilot).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "from", "to", "reply_to", "type", "at", "state", "next", "eta"],
  "properties": {
    "v": { "type": "string", "const": "1" },
    "id": { "$ref": "#/$defs/id" },
    "from": { "$ref": "#/$defs/agent" },
    "to": { "$ref": "#/$defs/agent" },
    "reply_to": {
      "anyOf": [{ "const": "none" }, { "$ref": "#/$defs/id" }]
    },
    "type": { "type": "string", "enum": ["request", "ack", "result"] },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "UTC ISO 8601; the pattern requires the Z suffix."
    },
    "state": { "type": "string", "enum": ["open", "received", "done", "failed", "cancelled"] },
    "next": { "type": "string", "minLength": 1, "description": "The next action and its owner, or `none`." },
    "eta": {
      "type": "string",
      "pattern": "^(unknown|measured [^()]+ \\([^()]+\\))$",
      "description": "`unknown`, or `measured <duration> (<basis>)`."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "request" } } },
      "then": { "properties": { "state": { "const": "open" }, "reply_to": { "const": "none" } } }
    },
    {
      "if": { "properties": { "type": { "const": "ack" } } },
      "then": { "properties": { "state": { "const": "received" }, "reply_to": { "not": { "const": "none" } } } }
    },
    {
      "if": { "properties": { "type": { "const": "result" } } },
      "then": { "properties": { "state": { "enum": ["done", "failed", "cancelled"] }, "reply_to": { "not": { "const": "none" } } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+-[0-9]{4}$",
      "description": "`<sender>-<4 digits>`. That the prefix matches `from` is not checked here."
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)?$",
      "description": "An agent, optionally `/<session>`, or `operator`. The pattern admits no at-sign, so no mention can appear."
    }
  }
}
